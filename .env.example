# Mandatory in staging/production; generate a unique value per environment.
AUTH_SECRET=
DB_DRIVER=postgres
# Mandatory PostgreSQL URL. CI/staging/production must each use a dedicated database.
DATABASE_URL=postgresql://user:password@localhost:5432/hekmat_atelier
PGSSL_MODE=disable
# Local development only: set DB_DRIVER=pglite and optionally PGLITE_DATA_DIR=./.pgdata
GEMINI_API_KEY=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=
ALLOW_DEV_ADMIN_BOOTSTRAP=false
NESHAN_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SECURE_COOKIES=
# development | staging | production
APP_ENV=development
# Supplied by CI/deployment; never set to "latest".
GIT_SHA=
BACKUP_STORAGE_DRIVER=local
BACKUP_LOCAL_PATH=/var/backups/hekmat-atelier
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_COUNT=30
# Optional except during an explicit restore drill. Must identify a separate, empty PostgreSQL database.
RESTORE_TARGET_DATABASE_URL=
# Staging drill only; never enable in Production.
ALLOW_STAGING_RESTORE_DRILL=false
